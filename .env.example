# Development credentials only. Set different random values outside local demos.
GATEWAY_CONFIG=config/demo.yaml
GATEWAY_ADMIN_KEY=demo-admin-key-change-me
GATEWAY_METRICS_KEY=demo-metrics-key-change-me
DEMO_TEAM_KEY=demo-team-key-change-me
ANALYST_TEAM_KEY=demo-analyst-key-change-me
GATEWAY_STATE_BACKEND=memory
GATEWAY_AUDIT_PATH=data/audit.sqlite3
# PostgreSQL audit storage is independent of the memory/Redis state backend.
# Run `python -m alembic upgrade head` before starting a PostgreSQL-backed gateway.
# GATEWAY_AUDIT_BACKEND=postgres
# DATABASE_URL=postgresql+psycopg://gateway:YOUR_PASSWORD@127.0.0.1:55432/llm_gateway
# Production/distributed deployments select redis and disable insecure loopback HTTP exceptions.
# GATEWAY_STATE_BACKEND=redis
# REDIS_URL=redis://127.0.0.1:6379/0
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# ANTHROPIC_API_KEY=
# COMPATIBLE_API_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

